ArduPilotPlugin: do not deadlock lock-step before the first state
From https://github.com/ArduPilot/ardupilot_gazebo/pull/183 (commit 74c3ace by dougamann), rebased onto f116b03, drop once merged upstream

diff --git a/src/ArduPilotPlugin.cc b/src/ArduPilotPlugin.cc
index 0246604..c1f8517 100755
--- a/src/ArduPilotPlugin.cc
+++ b/src/ArduPilotPlugin.cc
@@ -1208,8 +1208,17 @@ void gz::sim::systems::ArduPilotPlugin::PreUpdate(
         {
             if (this->dataPtr->isLockStep)
             {
+                // Do not hold the step for ArduPilot until there is a state
+                // to answer it with. CreateStateJSON() produces none until
+                // the first IMU message has arrived; if the first servo
+                // packet lands before that, blocking here waits on an
+                // ArduPilot that is itself waiting on us -- it resends the
+                // same frame, the duplicate is answered with the empty
+                // state, and since PostUpdate never runs again no state is
+                // ever made: both sides wait forever.
                 while (!this->ReceiveServoPacket() &&
-                    this->dataPtr->arduPilotOnline)
+                    this->dataPtr->arduPilotOnline &&
+                    !this->dataPtr->json_str.empty())
                 {
                     // SIGNINT should interrupt this loop.
                     if (this->dataPtr->signal != 0)
@@ -2035,6 +2044,12 @@ void gz::sim::systems::ArduPilotPlugin::CreateStateJSON(
 /////////////////////////////////////////////////
 void gz::sim::systems::ArduPilotPlugin::SendState() const
 {
+    // No state yet (no IMU message received): an empty datagram is not a
+    // state, and ArduPilot reads it as nothing at all.
+    if (this->dataPtr->json_str.empty())
+    {
+        return;
+    }
 #if DEBUG_JSON_IO
     auto bytes_sent =
 #endif
